<?php
/**
 * Develo_TopRatedCollage
 *
 * A "huge" two-tile collage of the two highest-rated catalog products, shown at
 * the top of the homepage. Hyvä compatible: Tailwind styling, no extra JS.
 */
declare(strict_types=1);

use Develo\TopRatedCollage\ViewModel\TopRatedProducts;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var TopRatedProducts $collage */
$collage = $viewModels->require(TopRatedProducts::class);
$products = $collage->getProducts(2);

if (count($products) < 2) {
    // Only render the collage when we have two products to show.
    return;
}
?>
<section class="my-6" aria-labelledby="top-rated-collage-heading">
    <h2 id="top-rated-collage-heading" class="mb-4 text-2xl font-bold sm:text-3xl">
        <?= $escaper->escapeHtml(__('Top Rated by Our Customers')) ?>
    </h2>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <?php foreach ($products as $product): ?>
            <?php
            $name = (string) $product->getName();
            $percent = $collage->getRatingPercent($product);
            $ratingValue = $collage->getRatingValue($product);
            $reviews = $collage->getReviewsCount($product);
            ?>
            <a href="<?= $escaper->escapeUrl($product->getProductUrl()) ?>"
               class="group relative block h-80 overflow-hidden rounded-2xl bg-gray-100 shadow-sm
                      transition-shadow hover:shadow-lg sm:h-96 lg:h-[34rem]">

                <img src="<?= $escaper->escapeUrl($collage->getImageUrl($product)) ?>"
                     alt="<?= $escaper->escapeHtmlAttr($name) ?>"
                     loading="lazy"
                     class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"/>

                <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-1 rounded-full
                             bg-primary px-3 py-1 text-xs font-semibold text-on-primary shadow">
                    <?= $escaper->escapeHtml(__('★ Top Rated')) ?>
                </span>

                <div class="absolute inset-x-0 bottom-0 z-10 bg-gradient-to-t from-black/80 via-black/30 to-transparent
                            p-5 pt-16 text-white sm:p-7 sm:pt-24">
                    <h3 class="text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl">
                        <?= $escaper->escapeHtml($name) ?>
                    </h3>

                    <div class="mt-2 flex items-center gap-2 text-sm">
                        <span class="relative inline-block text-lg leading-none"
                              role="img"
                              aria-label="<?= $escaper->escapeHtmlAttr(__('Rated %1 out of 5', $ratingValue)) ?>">
                            <span class="text-white/30">★★★★★</span>
                            <span class="absolute inset-0 overflow-hidden whitespace-nowrap text-yellow-400"
                                  style="width: <?= (int) $percent ?>%">★★★★★</span>
                        </span>
                        <span class="text-white/80">
                            <?= $escaper->escapeHtml((string) $ratingValue) ?>
                            <span class="text-white/60">(<?= (int) $reviews ?>)</span>
                        </span>
                    </div>

                    <div class="mt-3 flex items-center justify-between gap-4">
                        <span class="text-lg font-semibold"><?= /* @noEscape */ $collage->getPriceHtml($product) ?></span>
                        <span class="inline-flex items-center gap-1 rounded-lg bg-white px-4 py-2 text-sm font-semibold
                                     text-gray-900 transition-colors group-hover:bg-primary group-hover:text-on-primary">
                            <?= $escaper->escapeHtml(__('Shop now')) ?>
                            <span aria-hidden="true">&rarr;</span>
                        </span>
                    </div>
                </div>
            </a>
        <?php endforeach; ?>
    </div>
</section>
